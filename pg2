                status.TextColor3 = Color3.fromRGB(255, 100, 100)
                return
            end

            local target
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == string.lower(name) then
                    target = p
                    break
                end
            end

            if not target then
                for _, p in ipairs(Players:GetPlayers()) do
                    if string.lower(p.DisplayName) == string.lower(name) then
                        target = p
