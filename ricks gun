local function makePart(

    parent,

    name,

    size,

    color,

    material,

    cframe

)

    local part =

        Instance.new("Part")

    part.Name = name

    part.Size = size

    part.Color = color

    part.Material = material

    part.CFrame = cframe

    part.CanCollide = false

    part.CanTouch = false

    part.CanQuery = false

    part.Massless = true

    part.CastShadow = false

    part.Parent = parent

    return part

end

--============================================================

-- WELD

--============================================================

local function weldPart(

    part,

    handle

)

    local weld =

        Instance.new(

            "WeldConstraint"

        )

    weld.Part0 = handle

    weld.Part1 = part

    weld.Parent = part

end

