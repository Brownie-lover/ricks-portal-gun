                            )

                            * GUN_SCALE

                        core.Size =

                            baseSize

                            * pulse

                        coreLight.Brightness =

                            3

                            +

                            math.sin(

                                os.clock() * 5

                            )

                    end

                )

        end

    )

    --========================================================

    -- УБИРАЕМ HUD

    --========================================================

    tool.Unequipped:Connect(

        function()

            stopCoordinateHUD()

            if gunAnimationConnection then

                gunAnimationConnection:Disconnect()

                gunAnimationConnection = nil

            end

            main.Visible = false

        end

    )

    --========================================================

    -- ЛКМ

    --========================================================

    tool.Activated:Connect(

